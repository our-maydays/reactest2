.grid-wrapper {
	position: relative;
}

.grid-wrapper .slick-dots {
	position: relative;
	bottom: 0;
	left: 0;
	right: 0;
	margin: 0;
	padding: 0;
	display: flex;
	align-items: center;	
}

.grid-wrapper .slick-dots li {
	position: relative;
	top: 50%;
	transform: translateY(-50%);	
	margin: 0 1px;
	padding: 0;
	line-height: 1rem;
	font-size: 1rem;
	height: 1rem;
}

.grid-wrapper .slick-dots li button {
	padding: 0;
	margin: 0;
	height: 1rem;
	line-height: 1rem;
}

.grid-wrapper .slick-dots li button:before {
	line-height: 1rem;
}

.grid-item {
	padding-bottom: 0px;
	padding-left: 8px;
	padding-top: 0;
	padding-right: 8px;
}

.grid-item img {
	width: 100%;
	display: block;
	border-radius: 0.5rem;
}

.modal-wrapper {
	position: relative;
	width: 100%;
	height: 100%;
}

.modal-container,
.modal-container .slick-slider,
.modal-container .slick-list,
.modal-container .slick-track,
.modal-container .slick-slide,
.modal-container .slick-slide > div {
	height: 100% !important;
	width: 100%;
}

.modal-container {
	width: 100%;
	height: 100%;
	margin: auto;
	display: flex;
	align-items: center;
	justify-content: center;
}

.modal-slide {
	width: 100%;
	height: 100%;		 
	margin: auto;
	display: flex !important;
	justify-content: center;
	align-items: center;
	background-color: none;
}


.modal-image {
	max-width: 100%;
	max-height: 80%;	
	width: 100% !important;
	height: auto !important;
	object-fit: contain !important;
	display: block;
	margin: auto;
}

.modal-container .slick-dots {
	position: absolute;
	bottom: 20px;
	left: 50%;
	right: 0;
	transform: translateX(-50%);
/*	display: flex !important;*/
	align-items: center;
	justify-content: center;
	margin: 0;
	padding: 0;
	outline: 1px solid red;
	width: 50px;
	height: 20px;
/*	overflow: hidden; */
	display: block !important; 
}

.modal-container .slick-dots ul {
	display: flex !important;
	align-items: center;
	padding: 0;
	margin: 0;
	list-style: none;
	will-change: transform;
	width: max-content;
	height: 100%;
}

.modal-container .slick-dots li {
	width: 15px !important;
	height: 100%;
	margin: 0 !important;
	padding: 0;
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;
	line-height: 1.4rem;
	height: 1.4rem;
outline: 1px solid green;
}

.modal-container .slick-dots li.slick-active {
/*	transform: scale(1.2);*/
}
.modal-container .slick-dots li button {
	padding: 0;
	margin: 0;
	height: 1.4rem;
	line-height: 1.4rem;
	width: 1.4rem;
	border: none;
	cursor: pointer;
	position: relative !important;
	outline: 1px solid red; 
}

.modal-container .slick-dots li button:before {
	line-height: 1.4rem;
	position: absolute !important;
	top: 50%;
	left: 50%;
transform: translate(-50%, -50%);
	width: auto;
height: auto;
	text-align: center;
}

.modal-container .slick-dots li.slick-active  button:before {
	transform: scale(1.0);
}

.modal-container .slick-dots li.near {
	transform: scale(1.0);
}

.modal-container .slick-dots li.far {
	transform: scale(1.0);
}

	{/*
.modal-container .slick-dots li.slick-active + li,
.modal-container .slick-dots li.slick-active ~ li:nth-child(2) {
	transform: scale(0.5);
}

.modal-container .slick-dots li:has(+ .slick-active) {
transform: scale(0.5);
}
*/}
